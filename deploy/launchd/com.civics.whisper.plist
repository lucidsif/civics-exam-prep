<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.civics.whisper</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/whisper-server</string>
    <string>-m</string><string>/Users/youruser/whisper-models/ggml-small.en.bin</string>
    <string>--host</string><string>127.0.0.1</string>
    <string>--port</string><string>8090</string>
    <string>--inference-path</string><string>/v1/audio/transcriptions</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/Users/youruser/Library/Logs/civics-whisper.log</string>
  <key>StandardErrorPath</key><string>/Users/youruser/Library/Logs/civics-whisper.log</string>
</dict>
</plist>
